"""skia-python 144.1 的最小类型桩：只声明本库用到的 API。

skia-python 是无桩的编译扩展（.pyd），此文件仅供 pyright 做静态检查，
不影响运行时（运行时导入的是真实的 .pyd）。签名以 144.1 实际行为为准。
"""

from collections.abc import Sequence
from typing import Any

import numpy as np
from numpy.typing import NDArray

def Color(r: int, g: int, b: int, a: int = 255) -> int: ...

class FontStyle:
    @staticmethod
    def Normal() -> FontStyle: ...
    @staticmethod
    def Bold() -> FontStyle: ...
    @staticmethod
    def Italic() -> FontStyle: ...

class Typeface:
    @staticmethod
    def MakeFromName(name: str, style: FontStyle) -> Typeface: ...
    @staticmethod
    def MakeFromFile(path: str) -> Typeface | None: ...
    def getFamilyName(self) -> str: ...
    def countGlyphs(self) -> int: ...

class FontMetrics:
    fAscent: float
    fDescent: float
    fLeading: float

class Font:
    def __init__(self, typeface: Typeface, size: float) -> None: ...
    def getSize(self) -> float: ...
    def unicharToGlyph(self, codepoint: int) -> int: ...
    def measureText(self, text: str, paint: Paint | None = None) -> float: ...
    def getMetrics(self) -> FontMetrics: ...

class Paint:
    kFill_Style: int
    kStroke_Style: int
    kButt_Cap: int
    kRound_Cap: int
    kSquare_Cap: int
    kRound_Join: int

    def __init__(
        self,
        *,
        AntiAlias: bool = False,
        Color: int = 0,
        Style: int = 0,
        StrokeWidth: float = 0.0,
        StrokeCap: int = 0,
        StrokeJoin: int = 0,
        Alphaf: float = 1.0,
    ) -> None: ...

class Path:
    def moveTo(self, x: float, y: float) -> Path: ...
    def lineTo(self, x: float, y: float) -> Path: ...
    def rewind(self) -> None: ...

class Rect:
    @staticmethod
    def MakeXYWH(x: float, y: float, w: float, h: float) -> Rect: ...
    def left(self) -> float: ...
    def top(self) -> float: ...
    def width(self) -> float: ...
    def height(self) -> float: ...

class RRect:
    @staticmethod
    def MakeRectXY(rect: Rect, x_rad: float, y_rad: float) -> RRect: ...

class Image:
    @staticmethod
    def fromarray(array: NDArray[np.uint8]) -> Image: ...
    def toarray(self) -> NDArray[np.uint8]: ...
    def width(self) -> int: ...
    def height(self) -> int: ...

class Canvas:
    def clear(self, color: int) -> None: ...
    def drawString(self, text: str, x: float, y: float, font: Font, paint: Paint) -> None: ...
    def drawPath(self, path: Path, paint: Paint) -> None: ...
    def drawImage(self, image: Image, x: float, y: float) -> None: ...
    def drawRRect(self, rrect: RRect, paint: Paint) -> None: ...
    def save(self) -> None: ...
    def restore(self) -> None: ...
    def scale(self, sx: float, sy: float) -> None: ...
    def translate(self, dx: float, dy: float) -> None: ...

class Surface:
    def __init__(self, width: int, height: int) -> None: ...
    def width(self) -> int: ...
    def height(self) -> int: ...
    def getCanvas(self) -> Canvas: ...
    def makeImageSnapshot(self) -> Image: ...
    def __enter__(self) -> Canvas: ...
    def __exit__(self, *args: Any) -> None: ...

class FontMgr:
    @staticmethod
    def RefDefault() -> FontMgr: ...
    def matchFamilyStyle(self, familyName: str, style: FontStyle) -> Typeface | None: ...
    def matchFamilyStyleCharacter(
        self, familyName: str, style: FontStyle, bcp47: Sequence[str], character: int
    ) -> Typeface | None: ...
    def countFamilies(self) -> int: ...
    def getFamilyName(self, index: int) -> str: ...
